pipeline{
    agent any
    stages{
        stage("uptime")
        {
            steps{
                sh '''
                uptime
                '''
            }

        }

        stage("Ram-used"){
            steps{
                sh '''
                free -h
                '''
            }
    }

     stage("disk-usage "){
            steps{
                sh '''
                echo "Poll checking"
                '''
            }
       }
    }
}